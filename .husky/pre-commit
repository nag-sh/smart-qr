#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Enforce PR workflow: never commit directly to main.
branch="$(git branch --show-current)"
if [ "$branch" = "main" ]; then
  echo "⛔ Direct commits to 'main' are blocked by policy."
  echo "   Create a feature branch (e.g. git switch -c feat/my-change) and open a PR."
  exit 1
fi

# Lint the client before committing.
npm --prefix client run lint
